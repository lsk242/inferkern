# inferkern — environment template
# Copy to .env and fill in: cp .env.sample .env
# Loaded by: source .env  &&  make docker-run  (or via docker-compose --env-file .env)
# All vars are optional — unset means heuristic mode (no LLM, works offline).

# --- LLM (any OpenAI-compatible endpoint) ---
# Examples:
#   OpenAI:        https://api.openai.com/v1
#   OpenRouter:    https://openrouter.ai/api/v1
#   Local llama:   http://localhost:8080/v1   (llama-server --host 0.0.0.0 --port 8080 --model qwen3-4b.gguf)
# Leave empty to use heuristic planner (deterministic, good for CI/tests).
INFERKERN_LLM_ENDPOINT=
INFERKERN_LLM_API_KEY=
INFERKERN_LLM_MODEL=gpt-4o-mini

# --- Goal selection (which demo to converge) ---
# Options: web-server (nginx :80), smoke-test (Python http.server :8765), demo-static, container-host
INFERKERN_GOAL=/goals/web-server/goal.yaml

# --- Budgets (override goal.yaml) ---
INFERKERN_MAX_STEPS=
INFERKERN_TIMEOUT_MIN=
INFERKERN_DRY_RUN=         # 1 = don't execute tools (log only)

# --- Docker / VM knobs ---
INFERKERN_KEEP_ALIVE=1     # 1 = keep container alive serving after converge (demo); 0 = exit for harness/CI
INFERKERN_STATE_DIR=       # default /var/lib/inferkern in container, ./state locally
INFERKERN_IMAGE=inferkern:dev
